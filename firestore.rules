rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == 'sC94v8XaXmUMHK6eineEy25GIst2';
    }

    function staffPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isActiveStaff() {
      return signedIn()
        && exists(staffPath())
        && get(staffPath()).data.type == 'staff'
        && get(staffPath()).data.active == true;
    }

    function hasPermission(name) {
      return isOwner() || (
        isActiveStaff()
        && get(staffPath()).data.permissions is map
        && get(staffPath()).data.permissions.keys().hasAny([name])
        && get(staffPath()).data.permissions[name] == true
      );
    }

    function validStats(data) {
      return data.keys().hasOnly([
        'views',
        'whatsappClicks',
        'phoneClicks',
        'favoriteAdds',
        'updatedAt'
      ])
      && data.views is int
      && data.whatsappClicks is int
      && data.phoneClicks is int
      && data.favoriteAdds is int
      && data.views >= 0
      && data.whatsappClicks >= 0
      && data.phoneClicks >= 0
      && data.favoriteAdds >= 0;
    }

    match /cars/{carId} {
      allow read: if true;
      allow create: if hasPermission('carsCreate');
      allow delete: if hasPermission('carsDelete');
      allow update: if hasPermission('carsEdit') || (
        hasPermission('carsMarkSold')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['available', 'sold']
      );
    }

    match /carStats/{carId} {
      allow read: if hasPermission('analyticsView');
      allow delete: if isOwner();

      allow create: if signedIn()
        && validStats(request.resource.data)
        && request.resource.data.views <= 1
        && request.resource.data.whatsappClicks <= 1
        && request.resource.data.phoneClicks <= 1
        && request.resource.data.favoriteAdds <= 1
        && (
          request.resource.data.views
          + request.resource.data.whatsappClicks
          + request.resource.data.phoneClicks
          + request.resource.data.favoriteAdds
        ) <= 1;

      allow update: if signedIn()
        && validStats(request.resource.data)
        && request.resource.data.views >= resource.data.views
        && request.resource.data.whatsappClicks >= resource.data.whatsappClicks
        && request.resource.data.phoneClicks >= resource.data.phoneClicks
        && request.resource.data.favoriteAdds >= resource.data.favoriteAdds
        && request.resource.data.views <= resource.data.views + 1
        && request.resource.data.whatsappClicks <= resource.data.whatsappClicks + 1
        && request.resource.data.phoneClicks <= resource.data.phoneClicks + 1
        && request.resource.data.favoriteAdds <= resource.data.favoriteAdds + 1
        && (
          (request.resource.data.views - resource.data.views)
          + (request.resource.data.whatsappClicks - resource.data.whatsappClicks)
          + (request.resource.data.phoneClicks - resource.data.phoneClicks)
          + (request.resource.data.favoriteAdds - resource.data.favoriteAdds)
        ) <= 1;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow get: if signedIn() && (
        request.auth.uid == userId
        || isOwner()
        || hasPermission('usersView')
      );
      allow list: if isOwner() || hasPermission('usersView');
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /carFinance/{carId} {
      allow read, create, update, delete: if isOwner();
    }

    match /admins/{userId} {
      allow get: if signedIn() && (isOwner() || userId == request.auth.uid);
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    match /staffCredentials/{username} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
